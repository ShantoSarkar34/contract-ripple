{
  "name": "contract-ripple",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && npm run build -w @contract-ripple/shared && npm run build -w @contract-ripple/engine && npm run typecheck -w @contract-ripple/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:shared": "npm run build -w @contract-ripple/shared",
    "build:engine": "npm run build -w @contract-ripple/engine",
    "build:api": "npm run build -w @contract-ripple/shared && npm run build -w @contract-ripple/engine && npm run build -w @contract-ripple/api",
    "build:all": "npm run build && npm run build:api",
    "api:dev": "npm run dev -w @contract-ripple/api",
    "api:start": "npm run start -w @contract-ripple/api",
    "db:validate": "npm run db:validate -w @contract-ripple/api"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}

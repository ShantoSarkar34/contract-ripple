# Backend environment variables (apps/api)
# Copy to `apps/api/.env` for local development. Never commit real values.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string. Placeholder only.
# On Vercel, append `connection_limit=1` unless the provider supplies a pooler.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/contractripple?schema=public

# Session and CSRF secret. Required in production and must be at least 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A development-only fallback is used when NODE_ENV is not production.
AUTH_SECRET=

# Session cookie settings. `AUTH_COOKIE_SECURE` defaults to true in production.
# `AUTH_COOKIE_SAME_SITE` accepts lax | strict | none; `none` requires secure.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=lax

# Trust X-Forwarded-* headers for client IP detection. Defaults to true in
# production, which matches Vercel. Keep false when clients connect directly.
TRUST_PROXY=

# Optional GitHub integration. Use a GitHub App installation token or a
# fine-grained PAT with read-only `Contents` permission. Keep it server-side.
# Leave empty to disable GitHub analysis (the API reports github_not_configured).
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# ZIP source analysis accepts at most 10 MiB per upload (fixed in code).
# Vercel Functions additionally cap request bodies at 4.5 MB; see docs/deployment.md.

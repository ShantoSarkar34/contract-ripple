# Backend environment variables (apps/api)
# Copy to `apps/api/.env` for local development. Never commit real values.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string (Phase 3). Placeholder only.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/contractripple?schema=public

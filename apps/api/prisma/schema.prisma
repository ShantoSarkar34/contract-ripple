// ContractRipple database schema.
//
// Domain models for persisted users, sessions, projects, contract versions,
// comparison runs, findings, and source analysis. Authentication is backed by
// opaque server-side sessions; only hashes of session tokens are stored.
//
// Never put real credentials in this file; the connection string comes from the
// DATABASE_URL environment variable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  completed
  failed
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters used by the API rate limiter. Keys are opaque hashes,
/// not raw email addresses or IP addresses.
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Project {
  id              String           @id @default(cuid())
  ownerId         String?
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contracts       Contract[]
  analysisRuns    AnalysisRun[]
  sourceSnapshots SourceSnapshot[]

  @@index([ownerId])
}

model Contract {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  versions  ContractVersion[]

  @@index([projectId])
}

model ContractVersion {
  id             String        @id @default(cuid())
  contractId     String
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  label          String?
  format         String
  rawContent     String
  checksum       String
  openapiVersion String?
  title          String?
  infoVersion    String?
  warnings       Json?
  createdAt      DateTime      @default(now())
  baselineRuns   AnalysisRun[] @relation("BaselineVersion")
  candidateRuns  AnalysisRun[] @relation("CandidateVersion")

  @@index([contractId])
  @@index([checksum])
}

model AnalysisRun {
  id                       String          @id @default(cuid())
  projectId                String
  project                  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baselineVersionId        String
  baselineVersion          ContractVersion @relation("BaselineVersion", fields: [baselineVersionId], references: [id], onDelete: Cascade)
  candidateVersionId       String
  candidateVersion         ContractVersion @relation("CandidateVersion", fields: [candidateVersionId], references: [id], onDelete: Cascade)
  label                    String?
  status                   AnalysisStatus  @default(completed)
  truncated                Boolean         @default(false)
  totalFindings            Int
  nonBreakingCount         Int
  potentiallyBreakingCount Int
  unknownCount             Int
  durationMs               Int
  limitations              Json?
  baselineSummary          Json?
  candidateSummary         Json?
  createdAt                DateTime        @default(now())
  findings                 Finding[]
  sourceSnapshots          SourceSnapshot[]

  @@index([projectId])
  @@index([createdAt])
}

model Finding {
  id            String      @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  position      Int
  engineId      String
  category      String
  changeType    String
  risk          String
  path          String?
  method        String?
  operationId   String?
  location      String
  summary       String
  explanation   String
  before        String?
  after         String?
  createdAt     DateTime    @default(now())

  @@unique([analysisRunId, engineId])
  @@index([analysisRunId])
  @@index([risk])
}

model SourceSnapshot {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRunId String?
  analysisRun   AnalysisRun?   @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  sourceType    String
  repository    String?
  ref           String?
  fileCount     Int
  skippedCount  Int
  totalBytes    Int
  limitations   Json?
  createdAt     DateTime       @default(now())
  files         SourceFile[]
  impacts       SourceImpact[]

  @@index([projectId])
  @@index([analysisRunId])
  @@index([createdAt])
}

model SourceFile {
  id         String         @id @default(cuid())
  snapshotId String
  snapshot   SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  path       String
  bytes      Int
  skipped    Boolean        @default(false)
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([snapshotId])
}

model SourceImpact {
  id            String         @id @default(cuid())
  snapshotId    String
  snapshot      SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  position      Int
  filePath      String
  line          Int
  column        Int
  snippet       String
  call          String
  method        String
  path          String
  matchedMethod String
  matchedPath   String
  operationId   String?
  confidence    String
  evidence      String
  createdAt     DateTime       @default(now())

  @@index([snapshotId])
  @@index([filePath])
}

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage

# next.js
/.next/
/out/

# production builds
/build
/apps/*/dist
/packages/*/dist
/apps/*/build
/packages/*/build

# turbo / cache
.turbo
**/.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; keep placeholder examples
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database / uploads
/apps/api/uploads
/apps/api/tmp

# Frontend environment variables (Next.js)
# Copy to `.env.local` for local development. Never commit real values.

# Base URL of the Express API. Must include the versioned prefix.
# Use `/api/v1` (relative) when `API_PROXY_TARGET` is configured so browser
# requests stay same-origin and the session cookie remains first-party.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional server-side proxy target used by `next.config.ts` rewrites.
# Set to the API origin only, without the `/api/v1` suffix, for example:
#   API_PROXY_TARGET=https://contractripple-api.vercel.app
# Leave empty to call the API origin directly.
API_PROXY_TARGET=
